{
  "id": "content-3",
  "path": "/ads",
  "title": "广告管理",
  "icon": "PictureOutlined",
  "api": {
    "query": "content-3-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "广告标题",
        "field": "title",
        "placeholder": "请输入广告标题",
        "rules": [
          {
            "required": true,
            "message": "请输入广告标题",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "upload",
        "label": "广告图片",
        "field": "image",
        "placeholder": "请上传广告图片",
        "rules": [
          {
            "required": true,
            "message": "请上传广告图片",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "input",
        "label": "跳转链接",
        "field": "link",
        "placeholder": "请输入跳转链接"
      },
      {
        "type": "switch",
        "label": "启用",
        "field": "enabled",
        "value": true
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "title",
        "label": "广告标题"
      },
      {
        "type": "image",
        "prop": "image",
        "label": "广告图片"
      },
      {
        "type": "text",
        "prop": "link",
        "label": "跳转链接",
        "minWidth": 200
      },
      {
        "type": "switch",
        "prop": "enabled",
        "label": "状态"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
