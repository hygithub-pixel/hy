{
  "id": "content-3",
  "path": "/ads",
  "title": "广告管理",
  "icon": "Picture",
  "api": {
    "query": "content-3-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "component",
        "label": "广告标题",
        "field": "title",
        "placeholder": "请输入广告标题",
        "rules": [
          {
            "required": true,
            "message": "请输入广告标题",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "upload",
        "label": "广告图片",
        "field": "image",
        "placeholder": "请上传广告图片",
        "rules": [
          {
            "required": true,
            "message": "请上传广告图片",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "component",
        "label": "跳转链接",
        "field": "link",
        "placeholder": "请输入跳转链接",
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "启用",
        "field": "enabled",
        "value": true,
        "component": "el-switch"
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号",
        "width": 80
      },
      {
        "type": "text",
        "prop": "title",
        "label": "广告标题",
        "width": 180
      },
      {
        "type": "image",
        "prop": "image",
        "label": "广告图片",
        "width": 120
      },
      {
        "type": "text",
        "prop": "link",
        "label": "跳转链接",
        "minWidth": 200
      },
      {
        "type": "component",
        "prop": "enabled",
        "label": "状态",
        "width": 100,
        "component": "el-switch"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "width": 180,
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "handler": "() => {}"
          },
          {
            "label": "删除",
            "type": "danger",
            "handler": "() => {}"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}