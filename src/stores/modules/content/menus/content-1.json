{
  "id": "content-1",
  "path": "/articles",
  "title": "文章管理",
  "icon": "FileTextOutlined",
  "api": {
    "query": "content-1-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "文章标题",
        "field": "title",
        "placeholder": "请输入文章标题",
        "rules": [
          {
            "required": true,
            "message": "请输入文章标题",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "select",
        "label": "文章分类",
        "field": "category",
        "placeholder": "请选择文章分类",
        "options": [
          {
            "label": "公告",
            "value": "announcement"
          },
          {
            "label": "新闻",
            "value": "news"
          },
          {
            "label": "教程",
            "value": "tutorial"
          },
          {
            "label": "其他",
            "value": "other"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择文章分类",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "textarea",
        "label": "文章内容",
        "field": "content",
        "placeholder": "请输入文章内容",
        "rules": [
          {
            "required": true,
            "message": "请输入文章内容",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "switch",
        "label": "发布",
        "field": "published",
        "value": true
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "title",
        "label": "文章标题"
      },
      {
        "type": "text",
        "prop": "category",
        "label": "文章分类"
      },
      {
        "type": "text",
        "prop": "content",
        "label": "文章内容",
        "minWidth": 250
      },
      {
        "type": "switch",
        "prop": "published",
        "label": "发布状态"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
