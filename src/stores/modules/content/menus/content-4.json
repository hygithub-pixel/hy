{
  "id": "content-4",
  "path": "/comments",
  "title": "评论管理",
  "icon": "MessageOutlined",
  "api": {
    "query": "content-4-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "评论内容",
        "field": "content",
        "placeholder": "请输入评论内容",
        "rules": [
          {
            "required": true,
            "message": "请输入评论内容",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "input",
        "label": "评论用户",
        "field": "user",
        "placeholder": "请输入评论用户",
        "rules": [
          {
            "required": true,
            "message": "请输入评论用户",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "select",
        "label": "审核状态",
        "field": "status",
        "placeholder": "请选择审核状态",
        "options": [
          {
            "label": "待审核",
            "value": "pending"
          },
          {
            "label": "已通过",
            "value": "approved"
          },
          {
            "label": "已拒绝",
            "value": "rejected"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择审核状态",
            "trigger": "change"
          }
        ]
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "content",
        "label": "评论内容",
        "minWidth": 250
      },
      {
        "type": "text",
        "prop": "user",
        "label": "评论用户"
      },
      {
        "type": "text",
        "prop": "status",
        "label": "审核状态"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "审核",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
