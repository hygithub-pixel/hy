{
  "id": "product-1",
  "path": "/products",
  "title": "商品列表",
  "icon": "ShoppingOutlined",
  "api": {
    "list": "/api/products",
    "create": "/api/products",
    "update": "/api/products/:id",
    "delete": "/api/products/:id",
    "query": "product-1-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "商品名称",
        "field": "name",
        "placeholder": "请输入商品名称",
        "rules": [
          {
            "required": true,
            "message": "请输入商品名称",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "input",
        "label": "商品价格",
        "field": "price",
        "placeholder": "请输入商品价格",
        "rules": [
          {
            "required": true,
            "message": "请输入商品价格",
            "trigger": "blur"
          },
          {
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "message": "请输入正确的价格格式",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "upload",
        "label": "商品图片",
        "field": "image",
        "placeholder": "请上传商品图片",
        "rules": [
          {
            "required": true,
            "message": "请上传商品图片",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "select",
        "label": "商品分类",
        "field": "category",
        "placeholder": "请选择商品分类",
        "options": [
          {
            "label": "电子产品",
            "value": "electronics"
          },
          {
            "label": "服装",
            "value": "clothing"
          },
          {
            "label": "食品",
            "value": "food"
          },
          {
            "label": "家居",
            "value": "home"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择商品分类",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "textarea",
        "label": "商品描述",
        "field": "description",
        "placeholder": "请输入商品描述"
      },
      {
        "type": "switch",
        "label": "上架",
        "field": "onSale",
        "value": true
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "name",
        "label": "商品名称"
      },
      {
        "type": "text",
        "prop": "price",
        "label": "价格",
        "formatter": "(row) => `¥${row.price}`"
      },
      {
        "type": "image",
        "prop": "image",
        "label": "图片"
      },
      {
        "type": "text",
        "prop": "category",
        "label": "分类"
      },
      {
        "type": "switch",
        "prop": "onSale",
        "label": "状态"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
