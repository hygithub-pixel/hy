{
  "id": "product-2",
  "path": "/categories",
  "title": "分类管理",
  "icon": "CollectionTag",
  "api": {
    "query": "product-2-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "component",
        "label": "分类名称",
        "field": "name",
        "placeholder": "请输入分类名称",
        "rules": [
          {
            "required": true,
            "message": "请输入分类名称",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "分类描述",
        "field": "description",
        "placeholder": "请输入分类描述",
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "启用",
        "field": "enabled",
        "value": true,
        "component": "el-switch"
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号",
        "width": 80
      },
      {
        "type": "text",
        "prop": "name",
        "label": "分类名称",
        "width": 180
      },
      {
        "type": "text",
        "prop": "description",
        "label": "分类描述",
        "minWidth": 200
      },
      {
        "type": "component",
        "prop": "enabled",
        "label": "状态",
        "width": 100,
        "component": "el-switch"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "width": 180,
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "handler": "() => {}"
          },
          {
            "label": "删除",
            "type": "danger",
            "handler": "() => {}"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}