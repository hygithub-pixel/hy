{
  "id": "user-1",
  "path": "/users",
  "title": "用户列表",
  "icon": "User",
  "api": {
    "list": "/api/users",
    "create": "/api/users",
    "update": "/api/users/:id",
    "delete": "/api/users/:id",
    "query": "user-1-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "component",
        "label": "用户名",
        "field": "username",
        "placeholder": "请输入用户名",
        "rules": [
          {
            "required": true,
            "message": "请输入用户名",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "密码",
        "field": "password",
        "placeholder": "请输入密码",
        "rules": [
          {
            "required": true,
            "message": "请输入密码",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "角色",
        "field": "role",
        "placeholder": "请选择角色",
        "options": [
          {
            "label": "超级管理员",
            "value": "superadmin"
          },
          {
            "label": "管理员",
            "value": "admin"
          },
          {
            "label": "普通用户",
            "value": "user"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择角色",
            "trigger": "change"
          }
        ],
        "component": "el-select"
      },
      {
        "type": "upload",
        "label": "头像",
        "field": "avatar",
        "placeholder": "请上传头像"
      },
      {
        "type": "component",
        "label": "启用",
        "field": "enabled",
        "value": true,
        "component": "el-switch"
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号",
        "width": 80
      },
      {
        "type": "text",
        "prop": "username",
        "label": "用户名",
        "width": 150
      },
      {
        "type": "text",
        "prop": "role",
        "label": "角色",
        "width": 120
      },
      {
        "type": "image",
        "prop": "avatar",
        "label": "头像",
        "width": 80
      },
      {
        "type": "component",
        "prop": "enabled",
        "label": "状态",
        "width": 100,
        "component": "el-switch"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "width": 180,
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "handler": "() => {}"
          },
          {
            "label": "删除",
            "type": "danger",
            "handler": "() => {}"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}