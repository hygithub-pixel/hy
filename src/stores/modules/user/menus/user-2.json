{
  "id": "user-2",
  "path": "/roles",
  "title": "角色管理",
  "icon": "UserOutlined",
  "api": {
    "query": "user-2-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "角色名称",
        "field": "name",
        "placeholder": "请输入角色名称",
        "rules": [
          {
            "required": true,
            "message": "请输入角色名称",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "input",
        "label": "角色描述",
        "field": "description",
        "placeholder": "请输入角色描述"
      },
      {
        "type": "switch",
        "label": "启用",
        "field": "enabled",
        "value": true
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "name",
        "label": "角色名称"
      },
      {
        "type": "text",
        "prop": "description",
        "label": "角色描述",
        "minWidth": 200
      },
      {
        "type": "switch",
        "prop": "enabled",
        "label": "状态"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
