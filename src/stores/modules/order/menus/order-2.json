{
  "id": "order-2",
  "path": "/order-stats",
  "title": "订单统计",
  "icon": "LineChartOutlined",
  "api": {
    "query": "order-2-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "date",
        "label": "开始日期",
        "field": "startDate",
        "placeholder": "选择开始日期",
        "rules": [
          {
            "required": true,
            "message": "请选择开始日期",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "date",
        "label": "结束日期",
        "field": "endDate",
        "placeholder": "选择结束日期",
        "rules": [
          {
            "required": true,
            "message": "请选择结束日期",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "select",
        "label": "统计类型",
        "field": "statType",
        "placeholder": "请选择统计类型",
        "options": [
          {
            "label": "订单数量",
            "value": "orderCount"
          },
          {
            "label": "销售金额",
            "value": "salesAmount"
          },
          {
            "label": "平均金额",
            "value": "avgAmount"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择统计类型",
            "trigger": "change"
          }
        ]
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "date",
        "label": "日期"
      },
      {
        "type": "text",
        "prop": "orderCount",
        "label": "订单数量"
      },
      {
        "type": "text",
        "prop": "salesAmount",
        "label": "销售金额"
      },
      {
        "type": "text",
        "prop": "avgAmount",
        "label": "平均金额"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "查看详情",
            "type": "primary",
            "id": "edit"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
