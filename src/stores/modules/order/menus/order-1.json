{
  "id": "order-1",
  "path": "/orders",
  "title": "订单列表",
  "icon": "Document",
  "api": {
    "query": "order-1-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "component",
        "label": "订单编号",
        "field": "orderNo",
        "placeholder": "请输入订单编号",
        "rules": [
          {
            "required": true,
            "message": "请输入订单编号",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "订单状态",
        "field": "status",
        "placeholder": "请选择订单状态",
        "options": [
          {
            "label": "待支付",
            "value": "pending"
          },
          {
            "label": "已支付",
            "value": "paid"
          },
          {
            "label": "已发货",
            "value": "shipped"
          },
          {
            "label": "已完成",
            "value": "completed"
          },
          {
            "label": "已取消",
            "value": "cancelled"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择订单状态",
            "trigger": "change"
          }
        ],
        "component": "el-select"
      },
      {
        "type": "component",
        "label": "收货人",
        "field": "receiver",
        "placeholder": "请输入收货人",
        "rules": [
          {
            "required": true,
            "message": "请输入收货人",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "联系电话",
        "field": "phone",
        "placeholder": "请输入联系电话",
        "rules": [
          {
            "required": true,
            "message": "请输入联系电话",
            "trigger": "blur"
          }
        ],
        "component": "el-input"
      },
      {
        "type": "component",
        "label": "下单时间",
        "field": "orderTime",
        "placeholder": "选择下单时间",
        "rules": [
          {
            "required": true,
            "message": "请选择下单时间",
            "trigger": "change"
          }
        ],
        "component": "el-date-picker",
        "props": {
          "type": "datetime"
        }
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号",
        "width": 80
      },
      {
        "type": "text",
        "prop": "orderNo",
        "label": "订单编号",
        "width": 180
      },
      {
        "type": "text",
        "prop": "status",
        "label": "订单状态",
        "width": 120
      },
      {
        "type": "text",
        "prop": "receiver",
        "label": "收货人",
        "width": 120
      },
      {
        "type": "text",
        "prop": "phone",
        "label": "联系电话",
        "width": 140
      },
      {
        "type": "component",
        "prop": "orderTime",
        "label": "下单时间",
        "width": 180,
        "component": "el-date-picker"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "width": 180,
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "handler": "() => {}"
          },
          {
            "label": "删除",
            "type": "danger",
            "handler": "() => {}"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}