{
  "id": "finance-2",
  "path": "/expenses",
  "title": "支出管理",
  "icon": "WalletOutlined",
  "api": {
    "query": "finance-2-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "input",
        "label": "支出项目",
        "field": "item",
        "placeholder": "请输入支出项目",
        "rules": [
          {
            "required": true,
            "message": "请输入支出项目",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "select",
        "label": "支出类型",
        "field": "type",
        "placeholder": "请选择支出类型",
        "options": [
          {
            "label": "采购",
            "value": "purchase"
          },
          {
            "label": "人力",
            "value": "labor"
          },
          {
            "label": "运营",
            "value": "operation"
          },
          {
            "label": "其他",
            "value": "other"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择支出类型",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "input",
        "label": "支出金额",
        "field": "amount",
        "placeholder": "请输入支出金额",
        "rules": [
          {
            "required": true,
            "message": "请输入支出金额",
            "trigger": "blur"
          },
          {
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "message": "请输入正确的金额格式",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "date",
        "label": "支出日期",
        "field": "date",
        "placeholder": "选择支出日期",
        "rules": [
          {
            "required": true,
            "message": "请选择支出日期",
            "trigger": "change"
          }
        ]
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "text",
        "prop": "item",
        "label": "支出项目"
      },
      {
        "type": "text",
        "prop": "type",
        "label": "支出类型"
      },
      {
        "type": "text",
        "prop": "amount",
        "label": "支出金额"
      },
      {
        "type": "date",
        "prop": "date",
        "label": "支出日期"
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
