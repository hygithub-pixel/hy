{
  "id": "finance-1",
  "path": "/revenue",
  "title": "收入统计",
  "icon": "DollarOutlined",
  "api": {
    "query": "finance-1-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "date",
        "label": "统计日期",
        "field": "date",
        "placeholder": "选择统计日期",
        "rules": [
          {
            "required": true,
            "message": "请选择统计日期",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "select",
        "label": "统计类型",
        "field": "type",
        "placeholder": "请选择统计类型",
        "options": [
          {
            "label": "日统计",
            "value": "day"
          },
          {
            "label": "月统计",
            "value": "month"
          },
          {
            "label": "年统计",
            "value": "year"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择统计类型",
            "trigger": "change"
          }
        ]
      },
      {
        "type": "input",
        "label": "收入金额",
        "field": "amount",
        "placeholder": "请输入收入金额",
        "rules": [
          {
            "required": true,
            "message": "请输入收入金额",
            "trigger": "blur"
          },
          {
            "pattern": "^\\d+(\\.\\d{1,2})?$",
            "message": "请输入正确的金额格式",
            "trigger": "blur"
          }
        ]
      },
      {
        "type": "input",
        "label": "备注",
        "field": "remark",
        "placeholder": "请输入备注"
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号"
      },
      {
        "type": "date",
        "prop": "date",
        "label": "统计日期"
      },
      {
        "type": "text",
        "prop": "type",
        "label": "统计类型"
      },
      {
        "type": "text",
        "prop": "amount",
        "label": "收入金额"
      },
      {
        "type": "text",
        "prop": "remark",
        "label": "备注",
        "minWidth": 200
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "actions": [
          {
            "label": "编辑",
            "type": "primary",
            "id": "edit"
          },
          {
            "label": "删除",
            "type": "danger",
            "id": "delete"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}
