{
  "id": "finance-3",
  "path": "/finance-reports",
  "title": "财务报表",
  "icon": "DataLine",
  "api": {
    "query": "finance-3-query"
  },
  "formConfig": {
    "items": [
      {
        "type": "component",
        "label": "开始日期",
        "field": "startDate",
        "placeholder": "选择开始日期",
        "rules": [
          {
            "required": true,
            "message": "请选择开始日期",
            "trigger": "change"
          }
        ],
        "component": "el-date-picker",
        "props": {
          "type": "date"
        }
      },
      {
        "type": "component",
        "label": "结束日期",
        "field": "endDate",
        "placeholder": "选择结束日期",
        "rules": [
          {
            "required": true,
            "message": "请选择结束日期",
            "trigger": "change"
          }
        ],
        "component": "el-date-picker",
        "props": {
          "type": "date"
        }
      },
      {
        "type": "component",
        "label": "报表类型",
        "field": "type",
        "placeholder": "请选择报表类型",
        "options": [
          {
            "label": "利润表",
            "value": "profit"
          },
          {
            "label": "资产负债表",
            "value": "balance"
          },
          {
            "label": "现金流量表",
            "value": "cash"
          }
        ],
        "rules": [
          {
            "required": true,
            "message": "请选择报表类型",
            "trigger": "change"
          }
        ],
        "component": "el-select"
      }
    ]
  },
  "tableConfig": {
    "columns": [
      {
        "type": "index",
        "prop": "index",
        "label": "序号",
        "width": 80
      },
      {
        "type": "component",
        "prop": "startDate",
        "label": "开始日期",
        "width": 140,
        "component": "el-date-picker"
      },
      {
        "type": "component",
        "prop": "endDate",
        "label": "结束日期",
        "width": 140,
        "component": "el-date-picker"
      },
      {
        "type": "text",
        "prop": "type",
        "label": "报表类型",
        "width": 140
      },
      {
        "type": "text",
        "prop": "revenue",
        "label": "总收入",
        "width": 140
      },
      {
        "type": "text",
        "prop": "expense",
        "label": "总支出",
        "width": 140
      },
      {
        "type": "text",
        "prop": "profit",
        "label": "净利润",
        "width": 140
      },
      {
        "type": "actions",
        "prop": "actions",
        "label": "操作",
        "width": 180,
        "actions": [
          {
            "label": "查看",
            "type": "primary",
            "handler": "() => {}"
          },
          {
            "label": "导出",
            "type": "success",
            "handler": "() => {}"
          }
        ]
      }
    ],
    "pagination": {
      "currentPage": 1,
      "pageSize": 10,
      "pageSizes": [
        10,
        20,
        50
      ]
    }
  }
}