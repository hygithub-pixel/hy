{
  "module": "role",
  "title": "角色管理",
  "description": "对系统角色进行管理，包括角色的增删改查、权限分配等操作",
  
  "apis": {
    "list": { "path": "/roles", "method": "GET" },
    "get": { "path": "/roles/{id}", "method": "GET" },
    "create": { "path": "/roles", "method": "POST" },
    "update": { "path": "/roles/{id}", "method": "PUT" },
    "delete": { "path": "/roles/{id}", "method": "DELETE" }
  },

  "columns": [
    { "dataIndex": "roleName", "title": "角色名称", "width": 150 },
    { "dataIndex": "roleCode", "title": "角色编码", "width": 150 },
    { "dataIndex": "description", "title": "描述", "width": 200 },
    { "dataIndex": "status", "title": "状态", "width": 80 },
    { "dataIndex": "userCount", "title": "用户数量", "width": 100 },
    { "dataIndex": "createTime", "title": "创建时间", "width": 160 }
  ],

  "fields": [
    {
      "group": "基本信息",
      "items": [
        { "component": "a-input", "label": "角色名称", "name": "roleName", "required": true, "placeholder": "请输入角色名称" },
        { "component": "a-input", "label": "角色编码", "name": "roleCode", "required": true, "placeholder": "请输入角色编码" },
        { "component": "a-input", "label": "描述", "name": "description", "placeholder": "请输入角色描述" },
        { "component": "a-radio-group", "label": "状态", "name": "status", "optionType": "button", "options": [{ "label": "启用", "value": 1 }, { "label": "禁用", "value": 0 }] }
      ]
    }
  ],

  "buttons": {
    "toolbar": [
      { "component": "a-button", "type": "primary", "text": "新增", "action": "create" },
      { "component": "a-button", "text": "批量删除", "action": "batchDelete", "disabledWhen": "noSelection" }
    ],
    "rowActions": [
      { "component": "a-button", "text": "编辑", "action": "edit", "size": "small" },
      { "component": "a-button", "text": "删除", "action": "delete", "size": "small", "danger": true }
    ]
  },

  "search": {
    "fields": [
      { "component": "a-input", "name": "roleName", "placeholder": "请输入角色名称", "allowClear": true },
      { "component": "a-select", "name": "status", "placeholder": "请选择状态", "allowClear": true, "options": [{ "label": "全部", "value": "" }, { "label": "启用", "value": 1 }, { "label": "禁用", "value": 0 }] }
    ],
    "actions": [
      { "component": "a-button", "type": "primary", "text": "查询", "action": "search" },
      { "component": "a-button", "text": "重置", "action": "reset" }
    ]
  }
}
