{
  "module": "product",
  "title": "商品管理",
  "description": "对系统中商品进行管理，包括商品的上架、下架、编辑、删除等操作",
  
  "apis": {
    "list": { "path": "/products", "method": "GET" },
    "get": { "path": "/products/:id", "method": "GET" },
    "create": { "path": "/products", "method": "POST" },
    "update": { "path": "/products/:id", "method": "PUT" },
    "delete": { "path": "/products/:id", "method": "DELETE" }
  },
  "columns": [
    { "dataIndex": "productName", "title": "商品名称", "width": 180 },
    { "dataIndex": "productCode", "title": "商品编码", "width": 120 },
    { "dataIndex": "category", "title": "商品分类", "width": 100 },
    { "dataIndex": "price", "title": "价格", "width": 100 },
    { "dataIndex": "stock", "title": "库存", "width": 80 },
    { "dataIndex": "sales", "title": "销量", "width": 80 },
    { "dataIndex": "status", "title": "状态", "width": 80 },
    { "dataIndex": "createTime", "title": "创建时间", "width": 160 }
  ],
  "fields": [
    {
      "group": "基本信息",
      "items": [
        { "component": "a-input", "label": "商品名称", "name": "productName", "required": true, "placeholder": "请输入商品名称" },
        { "component": "a-input", "label": "商品编码", "name": "productCode", "required": true, "placeholder": "请输入商品编码" },
        { "component": "a-select", "label": "商品分类", "name": "category", "required": true, "placeholder": "请选择商品分类", "options": [{ "label": "电子产品", "value": "电子产品" }, { "label": "服装", "value": "服装" }, { "label": "食品", "value": "食品" }, { "label": "图书", "value": "图书" }, { "label": "家居", "value": "家居" }] },
        { "component": "a-input-number", "label": "价格", "name": "price", "required": true, "min": 0, "precision": 2 },
        { "component": "a-input-number", "label": "库存", "name": "stock", "required": true, "min": 0 },
        { "component": "a-radio-group", "label": "状态", "name": "status", "optionType": "button", "options": [{ "label": "上架", "value": 1 }, { "label": "下架", "value": 0 }] }
      ]
    }
  ],
  "buttons": {
    "toolbar": [
      { "component": "a-button", "type": "primary", "text": "新增", "action": "create" }
    ],
    "rowActions": [
      { "component": "a-button", "text": "编辑", "action": "edit", "size": "small" },
      { "component": "a-button", "text": "删除", "action": "delete", "size": "small", "danger": true }
    ]
  },
  "search": {
    "fields": [
      { "component": "a-input", "name": "productName", "placeholder": "请输入商品名称", "allowClear": true },
      { "component": "a-select", "name": "category", "placeholder": "请选择分类", "allowClear": true, "options": [{ "label": "全部", "value": "" }, { "label": "电子产品", "value": "电子产品" }, { "label": "服装", "value": "服装" }, { "label": "食品", "value": "食品" }] },
      { "component": "a-select", "name": "status", "placeholder": "请选择状态", "allowClear": true, "options": [{ "label": "全部", "value": "" }, { "label": "上架", "value": 1 }, { "label": "下架", "value": 0 }] }
    ],
    "actions": [
      { "component": "a-button", "type": "primary", "text": "查询", "action": "search" },
      { "component": "a-button", "text": "重置", "action": "reset" }
    ]
  }
}
